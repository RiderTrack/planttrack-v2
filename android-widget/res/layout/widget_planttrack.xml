<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Marca: icono de la app + nombre -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="PlantTrack" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:text="PlantTrack"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Dato principal: total de plantas -->
    <TextView
        android:id="@+id/widget_contador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="PlantTrack"
        android:textColor="#6EE7B7"
        android:textStyle="bold"
        android:textSize="21sp" />

    <!-- Próximo riego / estado -->
    <TextView
        android:id="@+id/widget_proximo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Abre la app para empezar"
        android:textColor="#D1FAE5"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
